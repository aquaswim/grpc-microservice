{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": [
    "kubectl@latest",
    "kubernetes-helm@latest",
    "kustomize@latest"
  ],
  "shell": {
    "init_hook": [
      "export KUBECONFIG=$DEVBOX_PROJECT_ROOT/kubeconfig.yaml",
      "echo download your kubernetes config and place them in $KUBECONFIG"
    ],
    "scripts": {
      "apply": "kubectl apply -k $DEVBOX_PROJECT_ROOT/manifests --validate='strict'",
      "apply:backing": "kubectl apply -k $DEVBOX_PROJECT_ROOT/manifests/backing-services --validate='strict'",
      "apply:apps": "kubectl apply -k $DEVBOX_PROJECT_ROOT/manifests/app-services --validate='strict'",
      "delete": "kubectl delete -k $DEVBOX_PROJECT_ROOT/manifests"
    }
  }
}
